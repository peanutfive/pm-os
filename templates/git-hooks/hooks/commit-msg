#!/usr/bin/env bash
# commit-msg — 对提交消息做轻量校验（只警告，不阻断）
# 检查：
#   - 首行是否有常见 conventional 前缀（feat/fix/chore/docs/refactor/test/style/perf/build/ci/revert）
#   - 首行长度 ≥ 10 字符
#   - 首行长度 ≤ 72 字符
#
# 这个 hook 只提醒，不阻断。真想阻断把 exit 0 改成 exit 1。

MSG_FILE=$1
FIRST_LINE=$(head -1 "$MSG_FILE" | sed 's/^[[:space:]]*//')

YELLOW=$'\033[1;33m'
DIM=$'\033[0;90m'
RESET=$'\033[0m'

# 跳过 merge / revert / fixup 这类 git 自动生成的
case "$FIRST_LINE" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

len=${#FIRST_LINE}
warnings=0

# 前缀检查
if ! echo "$FIRST_LINE" | grep -qE '^(feat|fix|chore|docs|refactor|test|style|perf|build|ci|revert)(\([^)]+\))?!?:'; then
  echo "${YELLOW}⚠  commit-msg: 首行没有 conventional 前缀${RESET}" >&2
  echo "${DIM}  建议：feat: / fix: / chore: / docs: / refactor: / test: / style: / perf:${RESET}" >&2
  echo "${DIM}  当前：${FIRST_LINE}${RESET}" >&2
  warnings=$((warnings+1))
fi

# 长度检查
if [ "$len" -lt 10 ]; then
  echo "${YELLOW}⚠  commit-msg: 首行太短（${len} 字符），建议描述更具体${RESET}" >&2
  warnings=$((warnings+1))
fi

if [ "$len" -gt 72 ]; then
  echo "${YELLOW}⚠  commit-msg: 首行过长（${len} 字符，建议 ≤ 72）${RESET}" >&2
  echo "${DIM}  长的细节放到正文里${RESET}" >&2
  warnings=$((warnings+1))
fi

if [ "$warnings" -gt 0 ]; then
  echo "${DIM}  （此检查只警告，不阻断；想改的话 git commit --amend）${RESET}" >&2
fi

exit 0
